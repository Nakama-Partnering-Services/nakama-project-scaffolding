{
	"name": "salesforce",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"lint": "eslint **/{aura,lwc}/**",
		"test": "yarn test:unit",
		"test:unit": "sfdx-lwc-jest",
		"test:unit:watch": "sfdx-lwc-jest --watch",
		"test:unit:debug": "sfdx-lwc-jest --debug",
		"test:unit:coverage": "sfdx-lwc-jest --coverage",
		"test:unit:silent": "sfdx-lwc-jest -- --silent=true",
		"prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
		"prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
		"prepare": "husky || true",
		"precommit": "lint-staged --quiet && node scripts/node/verify-branch-name",
		"prepush": "node scripts/node/verify-branch-name",
		"commit": "commit",
		"release:major": "npx commit-and-tag-version --release-as major",
		"release:minor": "npx commit-and-tag-version --release-as minor",
		"release:patch": "npx commit-and-tag-version --release-as patch"
	},
	"devDependencies": {
		"@commitlint/cli": "^17.0.3",
		"@commitlint/config-conventional": "^17.0.3",
		"@commitlint/prompt-cli": "^17.0.3",
		"@lwc/eslint-plugin-lwc": "^3.2.0",
		"@lwc/eslint-plugin-lwc-platform": "^6.3.0",
		"@prettier/plugin-xml": "^3.4.1",
		"@salesforce/eslint-config-lwc": "^4.0.0",
		"@salesforce/eslint-plugin-aura": "^3.0.0",
		"@salesforce/eslint-plugin-lightning": "^2.0.0",
		"@salesforce/sfdx-lwc-jest": "^7.0.2",
		"eslint": "^9.29.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jest": "^28.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"prettier": "^3.5.3",
		"prettier-plugin-apex": "^2.2.6"
	}
}
